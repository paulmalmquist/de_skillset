# Set a nonempty token before shared/container hosting. No real credentials belong here.
FLIGHTCHECK_TOKEN=
# Exact HTTP hostnames; a token is mandatory for non-loopback hosts.
FLIGHTCHECK_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Expire local runs after this many days. Redaction does not sanitize arbitrary SQL/metadata.
FLIGHTCHECK_RETENTION_DAYS=7
# Optional: path to a private environment-specific policy YAML.
# FLIGHTCHECK_POLICY=private/policy.yml
